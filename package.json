{
  "name": "hush",
  "version": "0.1.0",
  "description": "Dictation, file transcription and meeting notes for macOS",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#electrobun/view": "./.hutch/devkit/api/browser/index.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build:ui": "vite build",
    "prepare": "svelte-kit sync || echo ''",
    "app:prepare": "electrobun prepare",
    "app:dev": "bun run build:native && electrobun prepare && vite build && electrobun dev",
    "app:build": "bun run build:native && electrobun prepare && vite build && electrobun build --env=stable",
    "build:native": "bun scripts/build-native.ts",
    "check": "svelte-kit sync && electrobun prepare && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.bun.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test src/bun",
    "test:native": "cd native/hush-native && cargo test",
    "transcribe": "bun scripts/transcribe.ts",
    "systap": "bun scripts/systap.ts",
    "llm": "bun scripts/llm.ts"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@lucide/svelte": "^1.58.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bun": "^1.4.4",
    "electrobun": "2.0.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
