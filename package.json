{
  "name": "hush",
  "version": "0.1.0",
  "description": "Dictation, file transcription and meeting notes for macOS",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#electrobun/view": "./.hutch/devkit/api/browser/index.ts"
  },
  "scripts": {
    "dev": "electrobun prepare && vite dev",
    "build:ui": "vite build",
    "prepare": "(svelte-kit sync && electrobun prepare) || echo ''",
    "app:prepare": "electrobun prepare",
    "app:dev": "bun run build:native && electrobun prepare && vite build && electrobun dev",
    "app:build": "bun run build:native && electrobun prepare && vite build && electrobun build --env=stable",
    "build:native": "bun scripts/build-native.ts",
    "check": "svelte-kit sync && electrobun prepare && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.bun.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test src/bun",
    "test:native": "bun scripts/build-native.ts --deps-only && cd native/hush-native && swift test",
    "lint:native": "cd native/hush-native && swift format lint --strict --recursive Sources Tests Package.swift",
    "transcribe": "bun scripts/transcribe.ts",
    "systap": "bun scripts/systap.ts",
    "llm": "bun scripts/llm.ts"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@lucide/svelte": "^1.58.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "electrobun": "2.0.5",
    "shadcn-svelte": "1.7.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
